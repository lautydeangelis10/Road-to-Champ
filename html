func start_new_race():

	current_lap = 0

	race_running = false
	race_finished = false

	safety_car = false
	virtual_safety_car = false
	red_flag = false

	rain_intensity = 0.0
	track_wetness = 0.0

	last_event = ""
	radio_message = "Formation lap complete. Get ready."

	event_cooldown = 0

	race_states.clear()

	for driver in drivers:
		var state = RaceState.new(driver)

		state.tire_type = choose_starting_tire()

		race_states.append(state)

	player_state = race_states[0]

	update_ui()


func choose_starting_tire() -> String:

	var roll = rng.randf()

	if roll < 0.35:
		return "SOFT"

	elif roll < 0.85:
		return "MEDIUM"

	return "HARD"


