class Driver:
	var name: String
	var pace: int
	var qualifying: int
	var consistency: int
	var wet_skill: int
	var tire_management: int
	var aggression: int
	var racecraft: int
	var reputation: int
	var team: String

	func _init(
		n: String,
		p: int,
		q: int,
		c: int,
		w: int,
		t: int,
		a: int,
		r: int,
		team_name: String
	):
		name = n
		pace = p
		qualifying = q
		consistency = c
		wet_skill = w
		tire_management = t
		aggression = a
		racecraft = r
		reputation = 10
		team = team_name


class RaceState:
	var driver: Driver
	var position: int = 1
	var lap_time: float = 90.0
	var total_time: float = 0.0

	var tire_type: String = "MEDIUM"
	var tire_health: float = 100.0
	var fuel: float = 100.0
	var ers: float = 100.0

	var front_wing: float = 100.0
	var engine: float = 100.0

	var strategy: String = "NORMAL"
	var pitting: bool = false
	var pit_laps_left: int = 0

	var alive: bool = true
	var dnf: bool = false

	func _init(d: Driver):
		driver = d


