		elif event.keycode == KEY_F2:

			rain_intensity = 0.8
			track_wetness = 0.7

			add_log("🌧️ DEBUG: LLUVIA FUERTE FORZADA")
			update_ui()

		# F3 = red flag
		elif event.keycode == KEY_F3:

			red_flag = true
			add_log("🚩 DEBUG: BANDERA ROJA FORZADA")
			update_ui()

		# F4 = desgaste
		elif event.keycode == KEY_F4:

			player_state.tire_health = 10

			add_log("🛞 DEBUG: NEUMÁTICOS AL 10%")
			update_ui()